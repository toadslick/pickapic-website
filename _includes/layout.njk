---
url: http://pick-a-pic.app
title: "Pick-a-Pic: Functional communication made easy."
author: James Childress
company: Pocket Pidgeon
custom: [
  { tag: 'meta', attrs: { name: 'theme-color', content: '#114477' }},
  { tag: 'icon', attrs: { type: 'image/x-icon', sizes: '16x16 32x32', href: '/favicon.ico' }},
  { tag: 'apple-touch-icon', attrs: { sizes: '192x192', href: '/favicon.png' }}
]
---

{% if path %}
  {% set segments = [url, path] %}
{% else %}
  {% set segments = [url] %}
{% endif %}

{% if styles %}
  {% set styles = [styles] %}
{% else %}
  {% set styles = ["/styles/main.css"] %}
{% endif %}

{% if scripts %}
  {% set scripts = (scripts.push("/scripts/dark-mode.js:defer"), scripts) %}
{% else %}
  {% set scripts = ["/scripts/dark-mode.js:defer"] %}
{% endif %}

<!doctype html>
<html lang="en">
  <head>
    {% metagen
    title = title,
    author = author,
    desc = description,
    url = segments | join("/"),
    comments = true,
    css = styles,
    custom = custom,
    js = scripts
 %}
  </head>
  <body>

    <header>
      <nav>
        <menu>
          <li>
            <a href="/">
              <span>
                Pick-a-Pic
              </span>
            </a>
          </li>
          <li>
            <a href="/help">Help</a>
          </li>
          <li>
            <a href="/about">About</a>
          </li>
          <li id="dark-mode-toggle">
            <input type="checkbox" id="dark-mode"/>
            <label for="dark-mode">
              <span>Dark mode</span>
            </label>
          </li>
          <li>
            <a class="app-store" href="#">
              <span>Download on the App Store</span>
            </a>
          </li>
        </menu>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer>
      <nav>
        <menu>
          <li>
            <a href="/">
              <span>
                Pick-a-Pic
              </span>
            </a>
          </li>
          <li>
            <a href="/help">Help</a>
          </li>
          <li>
            <a href="/about">About</a>
          </li>
          <li>
            <a class="app-store" href="#">
              <span>Download on the App Store</span>
            </a>
          </li>
        </menu>
      </nav>
      <p>
        <strong>Pick-a-Pic</strong>
        is made in Portland 🌲 by an app developer and a BCBA.
      </p>
      <p>&copy; 2026 Pocket Pidgeon</p>
    </footer>
  </body>
</html>