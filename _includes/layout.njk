---
url: http://pick-a-pic.app
title: "Pick-a-Pic: Functional communication made easy."
author: James Childress
company: Pocket Pidgeon
---

{% if path %}
  {% set segments = [url, path] %}
{% else %}
  {% set segments = [url] %}
{% endif %}

{% if styles %}
  {% set styles = [styles] %}
{% else %}
  {% set styles = ["/styles/main.css"] %}
{% endif %}

<!doctype html>
<html lang="en">
  <head>
    {% metagen
    title = title,
    author = author,
    desc = description,
    url = segments | join("/"),
    comments = true,
    css = styles,
    custom = custom
 %}
  </head>
  <body>
    <main>
      {{ content | safe }}
    </main>
  </body>
</html>