---
url: http://pick-a-pic.app
title: "Pick-a-Pic: easy AAC for early learners"
author: James Childress and Selina Field
company: Pocket Pigeon
custom: [
  { tag: 'meta', attrs: { name: 'theme-color', content: '#114477' }},
  { tag: 'meta', attrs: { name: 'darkreader-lock' }},
  { tag: 'icon', attrs: { type: 'image/x-icon', sizes: '16x16 32x32', href: '/favicon.ico' }},
  { tag: 'apple-touch-icon', attrs: { sizes: '192x192', href: '/favicon.png' }}
]
---

{% if styles %}
  {% set styles = [styles] %}
{% else %}
  {% set styles = ["/styles/main.css"] %}
{% endif %}

{% if scripts %}
  {% set scripts = (scripts.push("/scripts/dark-mode.js:defer"), scripts) %}
{% else %}
  {% set scripts = ["/scripts/dark-mode.js:defer"] %}
{% endif %}

<!doctype html>
<html lang="en">
  <head>
    {% metagen
    title = title,
    author = author,
    desc = description,
    comments = true,
    css = styles,
    custom = custom,
    js = scripts
 %}
  </head>
  <body>

    <header{% if page.url == "/" %} class="home"{% endif %}>
      <nav>
        <menu>
          <li>
            <a href="/">
              <span>
                Pick-a-Pic
              </span>
            </a>
          </li>

          {% for p in pages %}
            {% set pagePath = "/" + p.id + "/" %}
            <li>
              <a href="{{ pagePath }}"{% if page.url == pagePath %} aria-current="page"{% endif %}>
                {{ p.title }}
              </a>
            </li>
          {% endfor %}

          <li id="dark-mode-toggle">
            <input type="checkbox" id="dark-mode"/>
            <label for="dark-mode">
              <span>Dark mode</span>
            </label>
          </li>
          <li>
            <a class="app-store" href="#">
              <span>Download on the App Store</span>
            </a>
          </li>
        </menu>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer>
      <nav>
        <menu>
          <li>
            <a href="/">
              <span>
                Pick-a-Pic
              </span>
            </a>
          </li>

          {%- for p in pages %}
            {% set pagePath = "/" + p.id + "/" %}
            <li>
              <a href="{{ pagePath }}"{% if page.url == pagePath %} aria-current="page"{% endif %}>
                {{ p.title }}
              </a>
            </li>
          {% endfor -%}

          <li>
            <a class="app-store" href="#">
              <span>Download on the App Store</span>
            </a>
          </li>
        </menu>
      </nav>
      <p>
        <strong>Pick-a-Pic</strong>
        is made in Portland 🌲 by a BCBA and an app developer.
      </p>
      <p>&copy; 2026 Pocket Pigeon</p>
    </footer>
  </body>
</html>