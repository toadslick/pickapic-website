{% for h3 in docs %}
  <hgroup id="{{ h3.title | slugify }}">

    <h3>
      {{ h3.title | safe }}
    </h3>

    {% for h4 in h3.items %}
      <hgroup id="{{ h3.title + "_" + h4.title | slugify }}">

        <h4>
          {{ h4.title | safe }}
        </h4>

        <p>
          {% for p in h4.text %}
            <span>{{p}}</span>
          {% endfor %}
        </p>

        {% for image in h4.images %}
          {% set url = "/assets/docs/" + image + ".l.jpg" %}
          <a class="docs-image {{ 'docs-wide-image' if h4.wide }}"  href="{{url}}" target="_blank">
            <img srcset="{{url}} 2x"/>
          </a>
        {% endfor %}

        {% for h5 in h4.items %}
          <hgroup id="{{ h3.title + "_" + h4.title + "_" + h5.title | slugify }}">

            <h5>
              {{ h5.title | safe }}
            </h5>

            <p>
              {% for p in h5.text %}
                <span>{{p}}</span>
              {% endfor %}
            </p>

            {% for image in h5.images %}
              {% set url = "/assets/docs/" + image + ".l.jpg" %}
              <a class="docs-image {{ 'docs-wide-image' if h5.wide }}" href="{{url}}" target="_blank">
                <img srcset="{{url}} 2x"/>
              </a>
            {% endfor %}

          </hgroup>
        {% endfor %}
      </hgroup>
    {% endfor %}
  </hgroup>
{% endfor %}