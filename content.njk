---
pagination:
  data: pages
  size: 1
  alias: item
permalink: "/{{ item.id }}/"
layout: layout.njk
styles: /styles/main.css
---
<section>
  <nav>

    <h1>
      {{ item.title }}
    </h1>

    <menu>
      {% for section in item.sections %}
        <li>
          <a href="#{{ section.id }}">
            {{ section.title | safe }}
          </a>

          {% if section.id == "docs" %}
            <ul>

              {% for h3 in docs.docs %}
                <li>
                  <a href="#{{ h3.title | slugify }}">
                    {{ h3.title | safe }}
                  </a>
                </li>

                {% if h3.items %}
                  <ul>

                    {% for h4 in h3.items %}
                      <li>
                        <a href="#{{ (h3.title + "_" + h4.title) | slugify }}">
                          {{ h4.title | safe }}
                        </a>

                        {% if h4.items %}
                          <ul>

                            {% for h5 in h4.items %}
                              <li>
                                <a href="#{{ (h3.title + "_" + h4.title + "_" + h5.title) | slugify }}">
                                  {{ h5.title | safe }}
                                </a>
                              </li>
                            {% endfor %}

                          </ul>
                        {% endif %}

                      </li>
                    {% endfor %}

                  </ul>
                {% endif %}

              {% endfor %}

          </ul>
        {% endif %}

      </li>
    {% endfor %}
  </menu>

</nav>
<article>

  {% for section in item.sections %}
    <hgroup id="{{ section.id }}">

      <h2>
        {{ section.title | safe }}
      </h2>

      {% renderFile "_includes/content/" + section.id + "." + section.format,
      docs %}

    </hgroup>
  {% endfor %}

</article>
</section>