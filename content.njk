---
pagination:
  data: pages
  size: 1
  alias: item
permalink: "/{{ item.id }}/"
layout: layout.njk
styles: /styles/main.css
---
<section>
  <nav>

    <h1>
      {{ item.title }}
    </h1>

    <menu>
      {% for section in item.sections %}
        <li>
          <a href="#{{ section.id }}">
            {{ section.title | safe }}
          </a>
        </li>
      {% endfor %}
    </menu>

  </nav>
  <article>

    {% for section in item.sections %}
      <hgroup id="{{ section.id }}">

        <h2>
          {{ section.title | safe }}
        </h2>

        {% renderFile "_includes/content/" + section.id + "." + section.format,
        docs %}

      </hgroup>
    {% endfor %}

  </article>
</section>